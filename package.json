{
  "name": "bb-plugins",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for lqmanh BB plugins",
  "scripts": {
    "install:all": "npm install && bash scripts/run-all.sh install",
    "check": "bash scripts/run-all.sh check",
    "build": "bash scripts/run-all.sh build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bash scripts/run-all.sh test"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "jsdom": "^29.1.1",
    "prettier": "3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
